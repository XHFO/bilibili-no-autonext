{
  "manifest_version": 3,
  "name": "哔哩哔哩 · 关闭自动连播",
  "version": "1.2.0",
  "minimum_chrome_version": "119",
  "description": "视频播完后停在当前页面，阻止自动播放下一集或推荐视频；支持随时开关。",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "关闭哔哩哔哩自动连播" },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*", "https://player.bilibili.com/*"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": ["guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/*", "https://player.bilibili.com/*"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": ["settings.js"],
      "run_at": "document_start"
    }
  ]
}
